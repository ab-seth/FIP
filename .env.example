FIP_ENVIRONMENT=development
FIP_DATABASE_URL=postgresql+psycopg://fip:fip@db:5432/fip
FIP_JWT_SECRET=replace-with-at-least-32-random-characters
FIP_ACCESS_TOKEN_MINUTES=30
FIP_LOGIN_MAX_ATTEMPTS=3
FIP_LOGIN_LOCK_MINUTES=15
FIP_TRANSACTION_UPLOAD_MAX_BYTES=10485760
FIP_TRANSACTION_UPLOAD_MAX_ROWS=10000
FIP_BOOTSTRAP_ADMIN_USERNAME=admin
FIP_BOOTSTRAP_ADMIN_PASSWORD=replace-before-use
FIP_API_URL=http://localhost:8000
FIP_COOKIE_SECURE=false
POSTGRES_DB=fip
POSTGRES_USER=fip
POSTGRES_PASSWORD=fip
